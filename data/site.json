{
  "_readme": {
    "whatThisIs": "Everything that appears on EVERY page: the logo, the menu, the header button and the footer. Edit here once and both index.html and products.html follow.",
    "enabled": "Set \"enabled\": false on any item to hide it without deleting it. That is the JSON equivalent of commenting the markup out.",
    "menu": "Order in the array = order in the menu. Give an item a \"children\" array to turn it into a dropdown.",
    "icons": "An icon is either a Font Awesome class (\"fab fa-instagram\") or a path to an image (\"images/contact/icon-phone.svg\"). The renderer works out which."
  },

  "brand": {
    "href": "./",
    "logo": "images/header/logo.svg",
    "alt": "Dr. Maya Adhami"
  },

